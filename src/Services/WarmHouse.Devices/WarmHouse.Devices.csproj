<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    One project per service. The layers are folders, and the dependency rule
    (Api -> Infrastructure -> Application -> Domain) is a convention here rather
    than something the compiler enforces: at this size a project per layer was
    more ceremony than it was worth.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Shared/WarmHouse.Shared/WarmHouse.Shared.csproj" />
    <ProjectReference Include="../../Shared/WarmHouse.Shared.Contracts/WarmHouse.Shared.Contracts.csproj" />
  </ItemGroup>

  <!--
    Container settings for the IDE tooling: the image is always a Linux one, and
    the Dockerfile next to this project is built from the solution root so it can
    reach Directory.Build.props and the shared projects.
  -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>../../..</DockerfileContext>
    <DockerfileFile>Dockerfile</DockerfileFile>
  </PropertyGroup>

</Project>
