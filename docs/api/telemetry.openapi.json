{
  "openapi": "3.1.1",
  "info": {
    "title": "Telemetry",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8070/"
    }
  ],
  "paths": {
    "/api/v1/telemetry": {
      "post": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Accept a measurement from a device",
        "operationId": "IngestTelemetry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestMeasurementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Measurement history of a device",
        "operationId": "QueryTelemetry",
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/telemetry/latest": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Latest reading of a metric",
        "operationId": "GetLatestTelemetry",
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/threshold-rules": {
      "get": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Threshold rules of a house",
        "operationId": "ListThresholdRules",
        "parameters": [
          {
            "name": "houseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Create a threshold rule",
        "operationId": "CreateThresholdRule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateThresholdRuleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/threshold-rules/{id}": {
      "delete": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Delete a threshold rule",
        "operationId": "DeleteThresholdRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateThresholdRuleRequest": {
        "required": [
          "house_id",
          "device_id",
          "metric",
          "comparison",
          "threshold"
        ],
        "type": "object",
        "properties": {
          "house_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "metric": {
            "type": "string"
          },
          "comparison": {
            "type": "string"
          },
          "threshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "IngestMeasurementRequest": {
        "required": [
          "device_id",
          "house_id",
          "metric",
          "value",
          "unit",
          "measured_at"
        ],
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "house_id": {
            "type": "string",
            "format": "uuid"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": "string"
          },
          "measured_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Telemetry"
    },
    {
      "name": "Thresholds"
    }
  ]
}