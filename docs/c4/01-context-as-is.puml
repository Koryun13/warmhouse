@startuml C4_Context_AsIs
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста (C4, уровень 1) — «Тёплый дом», состояние As-Is

Person(resident, "Житель дома", "Владелец дома. Через веб-интерфейс включает и выключает отопление и смотрит текущую температуру. Сейчас таких клиентов ~100.")
Person(engineer, "Инженер по монтажу", "Выезжает на объект и вручную подключает оборудование дома к системе. Без него подключение невозможно.")
Person(support, "Оператор поддержки", "Помогает пользователям, смотрит состояние домов.")

System(monolith, "Smart Home (монолит)", "Приложение на Go с PostgreSQL. Управляет отоплением и хранит справочник датчиков. Всё взаимодействие синхронное.")

System_Ext(sensor, "Датчик температуры", "Установлен в доме. Отдаёт текущее значение температуры по HTTP-запросу от сервера.")
System_Ext(relay, "Реле управления отоплением", "Исполнительное устройство. Принимает команды включения и выключения от сервера.")

Rel(resident, monolith, "Управляет отоплением, смотрит температуру", "HTTPS")
Rel(support, monolith, "Просматривает состояние домов", "HTTPS")
Rel(engineer, monolith, "Регистрирует оборудование при монтаже", "HTTPS")

Rel(monolith, sensor, "Опрашивает температуру (запрос-ответ, синхронно)", "HTTP")
Rel(monolith, relay, "Отправляет команды управления", "HTTP")

note right of monolith
  Ключевые ограничения текущего решения:
  • всё взаимодействие синхронное, инициатор — всегда сервер;
  • устройства не могут сами присылать данные;
  • пользователь не может подключить датчик самостоятельно;
  • поддерживается ровно один сценарий — отопление.
end note

SHOW_LEGEND()
@enduml
