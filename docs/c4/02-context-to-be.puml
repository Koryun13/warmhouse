@startuml C4_Context_ToBe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста (C4, уровень 1) — экосистема «Тёплый дом», состояние To-Be

Person(resident, "Житель дома", "Самостоятельно покупает комплект, подключает устройства, настраивает сценарии и смотрит телеметрию.")
Person(support, "Оператор поддержки", "Помогает пользователям, видит состояние домов и устройств.")
Person(partner, "Партнёр-производитель", "Выпускает устройства и подключает их к экосистеме по стандартным протоколам.")

System_Boundary(ecosystem, "Экосистема умного дома «Тёплый дом» (SaaS)") {
    System(platform, "Платформа умного дома", "Микросервисная система: устройства, отопление, освещение, ворота, наблюдение, телеметрия, сценарии, уведомления.")
}

System_Ext(devices, "Устройства умного дома", "Термостаты, светильники, приводы ворот, камеры, датчики. Подключаются через интернет-канал дома и сами присылают телеметрию.")
System_Ext(pushProvider, "Провайдер уведомлений", "Push / e-mail / SMS.")
System_Ext(billing, "Биллинг и платежи", "Подписки на SaaS-тарифы.")

Rel(resident, platform, "Управляет домом, настраивает сценарии, смотрит телеметрию и видео", "HTTPS / WebSocket")
Rel(support, platform, "Диагностика и поддержка", "HTTPS")
Rel(partner, platform, "Регистрирует новые типы устройств", "HTTPS, каталог DeviceType")

Rel(devices, platform, "Присылают телеметрию и подтверждения команд", "MQTT / HTTPS")
Rel(platform, devices, "Отправляет команды", "MQTT / HTTPS / Zigbee-шлюз")

Rel(platform, pushProvider, "Отправляет уведомления", "HTTPS")
Rel(platform, billing, "Проверяет подписку", "HTTPS")

note right of platform
  Отличия от As-Is:
  • подключение устройств в режиме самообслуживания, без выезда инженера;
  • устройства сами инициируют передачу телеметрии (асинхронно);
  • новые типы устройств добавляются как записи каталога, без доработки кода;
  • кроме отопления — свет, ворота, видеонаблюдение и пользовательские сценарии.
end note

SHOW_LEGEND()
@enduml
